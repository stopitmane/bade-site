# Public site URL (canonical URLs, sitemap, schema). Defaults to https://web.badesemowo.com, so leave unset unless the domain changes.
# NEXT_PUBLIC_SITE_URL=https://web.badesemowo.com
# Google Analytics 4 measurement ID (optional)
NEXT_PUBLIC_GA_ID=
# Calendly link for /free-consultation. Defaults to https://calendly.com/badesemowo/20mins_freeconsulting
# NEXT_PUBLIC_CALENDLY_URL=
# Form email delivery through Resend (optional; without these, submissions are only logged)
RESEND_API_KEY=
CONTACT_TO_EMAIL=b.adesemowo@gmail.com
CONTACT_FROM_EMAIL=Website <onboarding@resend.dev>
